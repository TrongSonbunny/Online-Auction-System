<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" styleClass="mesh-gradient-bg"
            xmlns="http://javafx.com/javafx/8.0.171" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.auction.controllers.SellerController">
    
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="0" styleClass="title-bar">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text=" ROYAL AUCTION - SELLER DASHBOARD" styleClass="title-bar-text" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" /> 
            <Button onAction="#handleMinimize" styleClass="window-btn"><graphic><Region styleClass="icon-min"/></graphic></Button>
            <Button onAction="#handleMaximize" styleClass="window-btn"><graphic><Region styleClass="icon-max"/></graphic></Button>
            <Button onAction="#handleClose" styleClass="window-btn btn-close"><graphic><Region styleClass="icon-close"/></graphic></Button>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            
            <VBox alignment="CENTER" spacing="20.0" styleClass="glass-panel" maxWidth="500.0">
                <padding>
                    <Insets bottom="35.0" left="35.0" right="35.0" top="35.0"/>
                </padding>

                <VBox alignment="CENTER" spacing="10.0">
                    <Label text="TẠO PHIÊN ĐẤU GIÁ" styleClass="header-text" style="-fx-font-size: 24px;"/>
                    <Label text="Phát hành vật phẩm độc bản của bạn" style="-fx-text-fill: #a0aec0; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="18.0">
                    <VBox spacing="6.0">
                        <Label text="TÊN VẬT PHẨM" style="-fx-font-family: 'Montserrat'; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtName" promptText="Vd: Đồng hồ Rolex Submariner..." styleClass="text-field" />
                    </VBox>
                    
                    <VBox spacing="6.0">
                        <Label text="PHÂN LOẠI (CATEGORY)" style="-fx-font-family: 'Montserrat'; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtCategory" promptText="Vd: ART, ELECTRONICS, VEHICLE..." styleClass="text-field" />
                    </VBox>
                    
                    <VBox spacing="6.0">
                        <Label text="GIÁ KHỞI ĐIỂM (VNĐ)" style="-fx-font-family: 'Montserrat'; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtStartingPrice" promptText="Vd: 250000000" styleClass="text-field" />
                    </VBox>
                    
                    <VBox spacing="10.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                        <Button text="ĐĂNG BÁN VẬT PHẨM" onAction="#handleCreateAuction" styleClass="btn-primary" prefWidth="400.0" prefHeight="45.0" />
                        <Button text="Đăng xuất khỏi hệ thống" onAction="#handleLogout" styleClass="button-link" />
                    </VBox>
                </VBox>
                <Label fx:id="lblStatus" text="" style="-fx-font-weight: bold; -fx-alignment: center; -fx-wrap-text: true;" />
            </VBox>
        </VBox>
    </center>
</BorderPane>