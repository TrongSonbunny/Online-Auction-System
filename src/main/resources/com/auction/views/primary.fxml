<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controllers.PrimaryController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Đăng xuất" onAction="#handleLogout" style="-fx-cursor: hand; -fx-background-color: #ff4c4c; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <Label text="DANH SÁCH SẢN PHẨM ĐẤU GIÁ" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="Mã SP" prefWidth="100.0" />
            <TableColumn fx:id="colName" text="Tên Sản Phẩm" prefWidth="250.0" />
            <TableColumn fx:id="colPrice" text="Giá Hiện Tại ($)" prefWidth="150.0" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Nhập giá ($):" style="-fx-font-size: 14px;" />
        <TextField fx:id="txtBidAmount" promptText="VD: 1500.5" prefWidth="150.0" />
        <Button text="Đặt giá" onAction="#handlePlaceBid" style="-fx-cursor: hand; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

</VBox>