<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox fx:id="rootNode" alignment="TOP_CENTER" spacing="0" prefHeight="720.0" prefWidth="1280.0" 
      style="-fx-background-color: #0a0a0a;" stylesheets="@style.css" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.auction.controllers.PrimaryController">

  <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="40.0" spacing="10" style="-fx-background-color: rgba(255,255,255,0.05);">
    <Text fill="#d4af37" strokeType="OUTSIDE" strokeWidth="0.0" text="ROYAL AUCTION - BIDDER RADAR" style="-fx-font-weight: bold; -fx-font-size: 14px;">
      <HBox.margin><Insets left="20.0" /></HBox.margin> 
    </Text>
    <Region HBox.hgrow="ALWAYS" />
    <Button onAction="#handleMinimize" styleClass="window-control-btn" text="—" textFill="WHITE" style="-fx-font-weight: bold; -fx-background-color: transparent; -fx-cursor: hand;" />
    <Button onAction="#handleMaximize" styleClass="window-control-btn" text="☐" textFill="WHITE" style="-fx-font-weight: bold; -fx-background-color: transparent; -fx-cursor: hand;" />
    <Button onAction="#handleClose" styleClass="window-control-btn, close-btn" text="X" textFill="WHITE" style="-fx-font-weight: bold; -fx-background-color: transparent; -fx-cursor: hand;" />
  </HBox>

  <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

    <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="glass-panel">
      <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
      <Text fill="#d4af37" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="RADAR SẢN PHẨM" />
      <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="80.0" text="MÃ SP" />
          <TableColumn fx:id="colName" prefWidth="200.0" text="TÊN SẢN PHẨM" />
          <TableColumn fx:id="colPrice" prefWidth="130.0" text="GIÁ HIỆN TẠI" />
          <TableColumn fx:id="colTimeRemaining" prefWidth="120.0" text="CÒN LẠI" />
          <TableColumn fx:id="colStatus" prefWidth="100.0" text="TRẠNG THÁI" />
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
      </TableView>
      <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button onAction="#handleRefresh" styleClass="action-btn-outline" text="QUÉT LẠI RADAR" />
        <Hyperlink onAction="#handleLogout" text="Đăng xuất khỏi trạm" textFill="#888" />
      </HBox>
    </VBox>

    <VBox spacing="15.0" prefWidth="450.0" styleClass="glass-panel">
      <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
      
      <VBox fx:id="placeholderBox" alignment="CENTER" VBox.vgrow="ALWAYS">
        <Text fill="#888" style="-fx-font-size: 16px;" text="Chọn một vật phẩm để xem chi tiết" />
      </VBox>

      <ScrollPane fx:id="detailScrollPane" fitToWidth="true" style="-fx-background-color: transparent;" vbarPolicy="NEVER" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <VBox fx:id="detailContainer" spacing="15.0">
          
          <VBox alignment="CENTER" spacing="10.0">
            <StackPane style="-fx-border-color: #d4af37; -fx-border-radius: 8; -fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 8; -fx-padding: 10;">
                <ImageView fx:id="imgProduct" fitWidth="120" fitHeight="120" preserveRatio="true" />
                <Text fill="#555" text="No Image" StackPane.alignment="CENTER"/>
            </StackPane>
            <Label fx:id="lblDetailName" text="--" styleClass="gold-text" style="-fx-font-size: 20px; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Label fx:id="lblDetailStatus" text="--" style="-fx-background-color: #333; -fx-text-fill: white; -fx-padding: 3 10; -fx-background-radius: 15;"/>
          </VBox>

          <VBox spacing="5.0">
            <Label text="MÔ TẢ CHI TIẾT" styleClass="premium-label" />
            <Label fx:id="lblDetailDesc" text="--" textFill="#cccccc" wrapText="true"/>
          </VBox>

          <HBox spacing="15.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
              <Label text="DANH MỤC" styleClass="premium-label" />
              <Label fx:id="lblDetailCategory" text="--" textFill="WHITE" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
              <Label text="TÌNH TRẠNG" styleClass="premium-label" />
              <Label fx:id="lblDetailCondition" text="--" textFill="WHITE" />
            </VBox>
          </HBox>

          <HBox spacing="15.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
              <Label text="GIÁ KHỞI ĐIỂM" styleClass="premium-label" />
              <Label fx:id="lblDetailStartPrice" text="--" textFill="WHITE" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
              <Label text="GIÁ ƯỚC TÍNH" styleClass="premium-label" />
              <Label fx:id="lblDetailEstPrice" text="--" textFill="WHITE" />
            </VBox>
          </HBox>

          <VBox spacing="5.0">
            <Label text="THÔNG TIN NGƯỜI BÁN" styleClass="premium-label" />
            <Label fx:id="lblDetailSeller" text="--" textFill="#888" wrapText="true"/>
          </VBox>
          
          <Separator style="-fx-background-color: #333; -fx-padding: 2;"/>

          <Button fx:id="btnJoinLive" maxWidth="Infinity" onAction="#handleJoinLiveBidding" styleClass="btn-primary" prefHeight="45" text="VÀO PHÒNG ĐẤU GIÁ TRỰC TIẾP ➔" />
        </VBox>
      </ScrollPane>
    </VBox>
  </HBox>
</VBox>