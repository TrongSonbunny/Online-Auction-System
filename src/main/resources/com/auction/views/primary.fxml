<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@style.css" styleClass="mesh-gradient-bg" 
           xmlns="http://javafx.com/javafx/8.0.171" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.auction.controllers.PrimaryController">
           
    <VBox spacing="20.0" styleClass="glass-panel" StackPane.alignment="CENTER" maxWidth="750.0" maxHeight="550.0">
        
        <StackPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </StackPane.margin>
        
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5.0">
                <Label text="RADAR ĐẤU GIÁ" styleClass="header-text" style="-fx-font-size: 22px;"/>
                <Label text="Các báu vật đang chờ được sở hữu" style="-fx-text-fill: #a0aec0; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Đăng xuất khỏi hệ thống" onAction="#handleLogout" styleClass="button-link" />
        </HBox>

        <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="glass-card">
            <columns>
                <TableColumn fx:id="colId" text="MÃ SP" prefWidth="100.0" />
                <TableColumn fx:id="colName" text="TÊN SẢN PHẨM" prefWidth="350.0" />
                <TableColumn fx:id="colPrice" text="GIÁ HIỆN TẠI (VNĐ)" prefWidth="200.0" />
            </columns>
            <placeholder>
                <Label text="Đang đồng bộ dữ liệu từ trung tâm hệ thống..." style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="glass-card">
            <VBox spacing="4.0">
                <Label text="THAM GIA TRANH GIÁ" style="-fx-font-family: 'Montserrat'; -fx-font-weight: 900; -fx-text-fill: #d4af37; -fx-font-size: 15px;"/>
                <Label text="Chọn một sản phẩm trên bảng và nhập giá thầu" style="-fx-text-fill: #a0aec0; -fx-font-size: 12px;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER" spacing="12.0">
                <TextField fx:id="txtBidAmount" promptText="Nhập giá thầu (VNĐ)..." styleClass="text-field" prefWidth="200.0" prefHeight="40.0" />
                <Button text="ĐẶT GIÁ THẦU" onAction="#handlePlaceBid" styleClass="btn-primary" prefHeight="40.0" prefWidth="150.0" />
            </HBox>
        </HBox>
    </VBox>
</StackPane>