<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="rootNode" prefHeight="760.0" prefWidth="1366.0" 
            style="-fx-background-color: #0a0a0a;" stylesheets="@style.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.auction.controllers.AdminController">

    <top>
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="40.0" spacing="10" 
              style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 0 10 0 15;">
            <Text fill="#d4af37" strokeType="OUTSIDE" strokeWidth="0.0" text="ROYAL AUCTION - ADMIN CONTROL PANEL" 
                  style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleMinimize" styleClass="window-control-btn" text="—" textFill="WHITE"/>
            <Button onAction="#handleMaximize" styleClass="window-control-btn" text="☐" textFill="WHITE"/>
            <Button onAction="#handleClose" styleClass="window-control-btn, close-btn" text="X" textFill="WHITE"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.02); -fx-border-color: rgba(212, 175, 55, 0.2); -fx-border-width: 0 1 0 0;" prefWidth="250.0">
            <padding><Insets bottom="30.0" left="20.0" right="20.0" top="30.0" /></padding>
            <VBox alignment="CENTER" spacing="10.0">
                <Text text="👑" style="-fx-font-size: 60px; -fx-effect: dropshadow(three-pass-box, rgba(212, 175, 55, 0.5), 10, 0, 0, 0);"/>
                <Label fx:id="lblAdminName" text="ADMINISTRATOR" styleClass="gold-text" style="-fx-font-size: 18px;"/>
                <Label text="Hệ thống Quản trị" textFill="#888" style="-fx-font-size: 12px;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button maxWidth="Infinity" text="📦 QUẢN LÝ ĐẤU GIÁ" styleClass="btn-primary" prefHeight="45.0"/>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button maxWidth="Infinity" onAction="#handleLogout" text="ĐĂNG XUẤT" styleClass="action-btn-danger" prefHeight="40.0"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            
            <VBox styleClass="glass-panel" VBox.vgrow="ALWAYS" spacing="15.0">
                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox>
                        <Text fill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="TẤT CẢ PHIÊN ĐẤU GIÁ TRÊN HỆ THỐNG" />
                        <Text fill="#aaa" text="Toàn quyền kiểm soát: Có thể Hủy (PENDING) hoặc Kết thúc ép buộc (ACTIVE) bất kỳ phiên nào." />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleRefresh" styleClass="action-btn-outline" text="LÀM MỚI DỮ LIỆU" />
                </HBox>

                <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="MÃ SP" />
                        <TableColumn fx:id="colName" prefWidth="250.0" text="TÊN SẢN PHẨM" />
                        <TableColumn fx:id="colSeller" prefWidth="150.0" text="NGƯỜI BÁN" />
                        <TableColumn fx:id="colPrice" prefWidth="150.0" text="GIÁ CAO NHẤT" />
                        <TableColumn fx:id="colTimeRemaining" prefWidth="150.0" text="CÒN LẠI" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="TRẠNG THÁI" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>

                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <Button onAction="#handleCancelAuction" styleClass="action-btn-danger" text="❌ XÓA PHIÊN (PENDING)" prefHeight="40"/>
                    <Button onAction="#handleFinishAuction" style="-fx-background-color: #ff8c00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="⏹ KẾT THÚC ÉP BUỘC (ACTIVE)" prefHeight="40"/>
                    <Label fx:id="lblError" textFill="#ff4444" style="-fx-font-weight: bold;" wrapText="true"/>
                </HBox>
                
            </VBox>
        </VBox>
    </center>

</BorderPane>