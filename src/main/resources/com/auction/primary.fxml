<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" styleClass="main-root" xmlns="http://javafx.com/javafx/8.0.171" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controllers.PrimaryController">
    
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="30.0" spacing="10.0" styleClass="title-bar">
            <padding>
                <Insets right="10.0" left="15.0" />
            </padding>
            <Label text="AUCTION X - SÀN ĐẤU GIÁ" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleMinimize" styleClass="btn-window" text="—" />
            <Button mnemonicParsing="false" onAction="#handleMaximize" styleClass="btn-window" text="◻" />
            <Button mnemonicParsing="false" onAction="#handleClose" styleClass="btn-window-close" text="✕" />
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="glass-card">
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0"/>
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <HBox alignment="CENTER">
                <Label text="DANH SÁCH SẢN PHẨM ĐẤU GIÁ" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Đăng xuất" onAction="#handleLogout" styleClass="btn-primary" style="-fx-background-color: #ff4c4c;" />
            </HBox>

            <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="transparent-table">
                <columns>
                    <TableColumn fx:id="colId" text="Mã Phiên (Auction ID)" prefWidth="150.0" />
                    <TableColumn fx:id="colName" text="Tên Sản Phẩm" prefWidth="250.0" />
                    <TableColumn fx:id="colPrice" text="Giá Hiện Tại ($)" prefWidth="150.0" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="15.0">
                <Label text="Nhập giá muốn đặt ($):" style="-fx-text-fill: white; -fx-font-size: 14px;" />
                <TextField fx:id="txtBidAmount" promptText="VD: 1500.5" prefWidth="150.0" styleClass="input-field" />
                <Button text="Đặt giá ngay" onAction="#handlePlaceBid" styleClass="btn-primary" />
                <Button text="Làm mới" onAction="#loadData" styleClass="btn-toggle" />
            </HBox>

            <Label fx:id="lblMessage" text="" style="-fx-text-fill: #00c6ff; -fx-font-size: 13px;" />
        </VBox>
    </center>

</BorderPane>