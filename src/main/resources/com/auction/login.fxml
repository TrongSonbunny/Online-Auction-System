<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controllers.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="ĐĂNG NHẬP HỆ THỐNG ĐẤU GIÁ" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <TextField fx:id="txtUsername" promptText="Tên đăng nhập" maxWidth="200"/>
    <PasswordField fx:id="txtPassword" promptText="Mật khẩu" maxWidth="200"/>
    
    <Label fx:id="lblError" textFill="red"/>
    
    <Button text="Đăng Nhập" onAction="#handleLogin" prefWidth="100"/>
</VBox>