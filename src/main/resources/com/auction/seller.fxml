<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" styleClass="main-root" xmlns="http://javafx.com/javafx/8.0.171" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controllers.SellerController">
    
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="30.0" spacing="10.0" styleClass="title-bar">
            <padding>
                <Insets right="10.0" left="15.0" />
            </padding>
            <Label text="AUCTION X - QUẢN LÝ SẢN PHẨM" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleMinimize" styleClass="btn-window" text="—" />
            <Button mnemonicParsing="false" onAction="#handleMaximize" styleClass="btn-window" text="◻" />
            <Button mnemonicParsing="false" onAction="#handleClose" styleClass="btn-window-close" text="✕" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="glass-card" maxWidth="450.0" maxHeight="500.0">
            <BorderPane.margin>
                <Insets bottom="40.0" left="40.0" right="40.0" top="20.0"/>
            </BorderPane.margin>
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
            </padding>

            <Label text="THÊM SẢN PHẨM MỚI" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <VBox spacing="8.0" maxWidth="300.0">
                <Label text="Tên sản phẩm:" style="-fx-font-size: 14px; -fx-text-fill: #b3b3b3;"/>
                <TextField fx:id="txtName" promptText="Vd: iPhone 16 Pro" styleClass="input-field" />
            </VBox>

            <VBox spacing="8.0" maxWidth="300.0">
                <Label text="Danh mục:" style="-fx-font-size: 14px; -fx-text-fill: #b3b3b3;"/>
                <TextField fx:id="txtCategory" promptText="Vd: electronics" styleClass="input-field" />
            </VBox>

            <VBox spacing="8.0" maxWidth="300.0">
                <Label text="Giá khởi điểm ($):" style="-fx-font-size: 14px; -fx-text-fill: #b3b3b3;"/>
                <TextField fx:id="txtPrice" promptText="Vd: 999.0" styleClass="input-field" />
            </VBox>

            <VBox alignment="CENTER" spacing="15.0" maxWidth="300.0">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
                <Button text="Thêm Sản Phẩm" onAction="#handleAddItem" prefWidth="200.0" prefHeight="40.0" styleClass="btn-primary" />
                <Button text="Đăng xuất" onAction="#handleLogout" prefWidth="200.0" prefHeight="40.0" styleClass="btn-primary" style="-fx-background-color: #ff4c4c;" />
            </VBox>
        </VBox>
    </center>
</BorderPane>